<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.moneybags</groupId>
    <artifactId>moneybags</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Moneybags Banking System</name>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <springdoc.version>3.0.3</springdoc.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                    <configuration>
                        <!-- Windows can retain a just-released class or JAR handle briefly. -->
                        <retryOnError>true</retryOnError>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>identity-access-service</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>ui-bff</module>
        <module>deposit-account-service</module>
        <module>product-master-service</module>
        <module>credit-card-service</module>
        <module>kyc-service</module>
        <module>notification-service</module>
        <module>payments-service</module>
        <module>cif-service</module>
        <module>accounting-service</module>
        <module>bill-generation-service</module>
        <module>statements-service</module>
        <module>eod-reconciliation-service</module>
    </modules>

</project>
