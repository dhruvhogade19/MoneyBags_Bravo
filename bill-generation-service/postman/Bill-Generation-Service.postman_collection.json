{
  "info": {"name": "Moneybags Bill Generation Service", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8087"},
    {"key":"accountId","value":"11111111-1111-1111-1111-111111111111"},
    {"key":"billingPeriod","value":"2026-08"},
    {"key":"businessDate","value":"2026-08-13"},
    {"key":"billId","value":""},
    {"key":"settlementAmount","value":""}
  ],
  "item": [
    {"name":"Health", "request":{"method":"GET","url":"{{baseUrl}}/actuator/health"}},
    {"name":"Generate bill", "event":[{"listen":"test","script":{"exec":["pm.test('Generated', function () { pm.response.to.have.status(200); });","const bill = pm.response.json();","pm.collectionVariables.set('billId', bill.billId);","pm.collectionVariables.set('settlementAmount', bill.outstandingAmount);"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"bill-gen-2026-08-001"},{"key":"X-Correlation-Id","value":"postman-bill-001"}],"body":{"mode":"raw","raw":"{\n  \"accountId\": \"{{accountId}}\",\n  \"billingPeriod\": \"{{billingPeriod}}\",\n  \"businessDate\": \"{{businessDate}}\"\n}"},"url":"{{baseUrl}}/internal/v1/bills/generate"}},
    {"name":"Replay generate (idempotent)", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"bill-gen-2026-08-001"}],"body":{"mode":"raw","raw":"{\"accountId\":\"{{accountId}}\",\"billingPeriod\":\"{{billingPeriod}}\",\"businessDate\":\"{{businessDate}}\"}"},"url":"{{baseUrl}}/internal/v1/bills/generate"}},
    {"name":"Get full bill", "request":{"method":"GET","url":"{{baseUrl}}/api/v1/bills/{{billId}}"}},
    {"name":"Get Payments summary", "request":{"method":"GET","url":"{{baseUrl}}/internal/v1/bills/{{billId}}/summary"}},
    {"name":"Record settled payment", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"paymentId\": \"22222222-2222-2222-2222-222222222222\",\n  \"journalNumber\": \"JRN-POSTMAN-001\",\n  \"amount\": {{settlementAmount}},\n  \"currency\": \"INR\",\n  \"settledAt\": \"2026-08-13T20:00:00Z\"\n}"},"url":"{{baseUrl}}/internal/v1/bills/{{billId}}/payment-settlements"}},
    {"name":"Check Credit Card closure eligibility", "request":{"method":"GET","url":"{{baseUrl}}/internal/v1/bills/accounts/{{accountId}}/closure-eligibility"}},
    {"name":"Find bills", "request":{"method":"GET","url":"{{baseUrl}}/internal/v1/bills?accountId={{accountId}}&billingPeriod={{billingPeriod}}"}},
    {"name":"EOD close", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"eod-close-2026-08-13"}],"body":{"mode":"raw","raw":"{\"eodRunId\":\"EOD-2026-08-13\",\"businessDate\":\"{{businessDate}}\",\"commandReference\":\"eod-billing-2026-08-13\"}"},"url":"{{baseUrl}}/internal/v1/bills/eod/close"}}
  ]
}
