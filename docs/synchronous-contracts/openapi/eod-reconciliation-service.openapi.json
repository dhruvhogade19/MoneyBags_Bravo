  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BusinessDateResponse": {
        "type": "object",
        "required": [
          "businessDate",
          "status",
          "cutoffAt"
        ],
        "properties": {
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "cutoffAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "EodExceptionResolutionRequest": {
        "type": "object",
        "required": [
          "resolution",
          "resolvedBy"
        ],
        "properties": {
          "resolution": {
            "type": "string"
          },
          "resolvedBy": {
            "type": "string"
          },
          "waived": {
            "type": "boolean"
          }
        }
      },
      "EodResumeRequest": {
        "type": "object",
        "required": [
          "requestedBy",
          "reason"
        ],
        "properties": {
          "requestedBy": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "EodRunResponse": {
        "type": "object",
        "required": [
          "runId",
          "businessDate",
          "status",
          "steps",
          "exceptions",
          "version"
        ],
        "properties": {
          "runId": {
            "type": "string"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "EodStepRetryRequest": {
        "type": "object",
        "required": [
          "requestedBy",
          "reason"
        ],
        "properties": {
          "requestedBy": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
