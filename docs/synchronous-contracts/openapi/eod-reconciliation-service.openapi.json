        "properties": {
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "openedBy": {
            "type": "string"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
