{
  "openapi": "3.0.3",
  "info": {
    "title": "Moneybags EOD / Reconciliation Orchestrator API",
    "version": "1.0.0",
    "description": "Coordinates the business date and ordered synchronous end-of-day controls across Payments, Deposit, Credit Card, Billing, Accounting, Statements, and Notifications."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "API Gateway - public routes only"
    },
    {
      "url": "http://localhost:8091",
      "description": "Direct service URL"
    }
  ],
  "paths": {
    "/api/v1/business-date": {
      "get": {
        "tags": [
          "EOD / Reconciliation Orchestrator"
        ],
        "summary": "Get the current business date and cutoff state",
        "operationId": "getApiV1BusinessDate",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-visibility": "public",
        "x-consumers": [],
        "x-calls": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission"
          },
          "409": {
            "description": "State, concurrency, or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency unavailable"
          }
        }
      }
    },
    "/api/v1/eod/runs": {
      "post": {
        "tags": [
          "EOD / Reconciliation Orchestrator"
        ],
        "summary": "Start one EOD run for a business date",
        "operationId": "postApiV1EodRuns",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-visibility": "admin",
        "x-consumers": [],
        "x-calls": [
          "payments-service:POST:/internal/v1/payments/eod/cutoff",
          "payments-service:POST:/internal/v1/payments/eod/drain",
          "credit-card-service:GET:/internal/v1/credit-card-accounts/eod/readiness",
          "deposit-account-service:GET:/internal/v1/deposit-accounts/eod/readiness",
          "deposit-account-service:POST:/internal/v1/deposit-accounts/eod/accruals",
          "bill-generation-service:POST:/internal/v1/bills/eod/close",
          "accounting-service:POST:/internal/v1/trial-balances",
          "accounting-service:POST:/internal/v1/eod/reconciliation/runs",
          "statement-service:POST:/internal/v1/statements/eod/generate",
          "notification-service:POST:/internal/v1/notifications",
          "accounting-service:POST:/internal/v1/accounting-periods/{businessDate}/close"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EodRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission"
          },
          "409": {
            "description": "State, concurrency, or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartEodRunRequest"
              }
            }
          }
        }
      }
    },
