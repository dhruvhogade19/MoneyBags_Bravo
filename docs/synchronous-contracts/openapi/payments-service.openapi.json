  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "paymentType",
          "source",
          "destination",
          "amount",
          "currency",
          "reference"
        ],
        "properties": {
          "paymentType": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "destination": {
            "type": "object"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "EodPaymentCommand": {
        "type": "object",
        "required": [
          "eodRunId",
          "businessDate",
          "commandReference"
        ],
        "properties": {
          "eodRunId": {
            "type": "string"
          },
          "businessDate": {
            "type": "string",
            "format": "date"
          },
          "commandReference": {
            "type": "string"
          }
        }
      },
      "EodPaymentResult": {
        "type": "object",
        "required": [
          "pendingCount",
          "failedCount",
          "blockingPaymentReferences"
        ],
        "properties": {
          "pendingCount": {
            "type": "integer"
          },
          "failedCount": {
            "type": "integer"
          },
          "blockingPaymentReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PaymentCancelRequest": {
        "type": "object",
        "required": [
          "reasonCode"
        ],
        "properties": {
          "reasonCode": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "PaymentPage": {
        "type": "object",
        "required": [
          "content",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "required": [
          "paymentId",
          "paymentType",
          "status",
          "amount",
          "currency",
          "version"
        ],
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source": {
            "type": "object"
          },
          "destination": {
            "type": "object"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          },
          "journalNumber": {
            "type": "string"
          },
          "failure": {
            "type": "object"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "PaymentReversalRequest": {
        "type": "object",
        "required": [
          "journalNumber",
          "reasonCode",
          "occurredAt"
        ],
        "properties": {
          "journalNumber": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
