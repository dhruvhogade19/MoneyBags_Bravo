{
  "openapi": "3.0.3",
  "info": {
    "title": "Moneybags Payments Service API",
    "version": "1.0.0",
    "description": "Orchestrates book transfers, credit-card payments, merchant payments, cancellation, settlement, reversal, and refund states through synchronous peer APIs."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "API Gateway - public routes only"
    },
    {
      "url": "http://localhost:8087",
      "description": "Direct service URL"
    }
  ],
  "paths": {
    "/api/v1/payments": {
      "post": {
        "tags": [
          "Payments Service"
        ],
        "summary": "Create and synchronously execute a payment",
        "operationId": "postApiV1Payments",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-visibility": "public",
        "x-consumers": [],
        "x-calls": [
          "deposit-account-service:GET:/internal/v1/deposit-accounts/{accountId}/eligibility",
          "deposit-account-service:POST:/internal/v1/deposit-accounts/{accountId}/reservations",
          "accounting-service:POST:/internal/v1/payment-postings/settlements",
          "notification-service:POST:/internal/v1/notifications"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission"
          },
          "409": {
            "description": "State, concurrency, or idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        }
      }
    },
