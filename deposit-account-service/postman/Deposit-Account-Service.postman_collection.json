          "request": {"method": "GET", "header": [{"key": "X-Correlation-Id", "value": "fd-peer-{{runId}}"}], "url": "{{serviceUrl}}/internal/v1/deposit-accounts/fixed-deposits/{{fixedDepositId}}"}
