    {
      "name": "07 - Fixed deposit premature closure APIs",
      "item": [
        {
          "name": "Quote premature fixed deposit closure",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('New fixed deposit is correctly ineligible for premature closure', () => { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.fixedDepositId).to.eql(pm.collectionVariables.get('fixedDepositId')); pm.expect(body.eligible).to.eql(false); pm.expect(body.blockers.some(value => value.includes('Minimum holding period'))).to.eql(true); });"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Correlation-Id", "value": "fd-close-quote-{{runId}}"}],
            "url": "{{baseUrl}}/api/deposit-accounts/fixed-deposits/{{fixedDepositId}}/premature-closure-quotes",
            "body": {"mode": "raw", "raw": "{\n  \"customerId\": \"CIF-1001\",\n  \"destinationAccountId\": \"{{sourceAccountId}}\",\n  \"channel\": \"INTERNET_BANKING\",\n  \"requestedClosureDate\": \"{{businessDate}}\"\n}"}
          }
        },
        {
          "name": "Request premature fixed deposit closure",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('Ineligible premature closure is recorded as rejected', () => { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.closureType).to.eql('FD_PREMATURE'); pm.expect(body.status).to.eql('REJECTED'); pm.expect(body.rejectionCode).to.eql('PREMATURE_CLOSURE_CHECK_FAILED'); });",
            "pm.collectionVariables.set('fdClosureRequestId', pm.response.json().closureRequestId);"
          ]}}],
          "request": {
            "method": "POST",
