# Copy this file to .env. All stateful Moneybags services then read the same Oracle connection.
# .env is ignored and must never be committed with real credentials.
MONEYBAGS_DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
MONEYBAGS_DB_USERNAME=moneybags
MONEYBAGS_DB_PASSWORD=change-me
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_ENABLED=true
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false

# Local multi-service pool limits prevent a shared developer Oracle instance
# from exhausting its process/session handlers (ORA-12516).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Browser integration (Oracle JET dev server)
CORS_ALLOWED_ORIGIN=http://localhost:8000
CONSUMER_OIDC_REDIRECT_URI=http://localhost:8000/
ADMIN_OIDC_REDIRECT_URI=http://localhost:8000/
IDENTITY_SELF_REGISTRATION_ENABLED=true

# Demo KYC: bank admins can decide a case from CIF data without document upload.
# Set to true only when the physical-document workflow is required.
MONEYBAGS_KYC_DOCUMENTS_REQUIRED=false
