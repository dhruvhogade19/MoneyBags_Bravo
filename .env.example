# Copy this file to .env. All stateful Moneybags services then read the same Oracle connection.
# .env is ignored and must never be committed with real credentials.
MONEYBAGS_DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
MONEYBAGS_DB_USERNAME=moneybags
MONEYBAGS_DB_PASSWORD=change-me
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_ENABLED=true

# Accounting owns a separate Oracle user/schema even when all services share the same PDB URL.
MONEYBAGS_ACCOUNTING_DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
MONEYBAGS_ACCOUNTING_DB_USERNAME=MONEYBAGS_ACCOUNTING
MONEYBAGS_ACCOUNTING_DB_PASSWORD=change-me

# Temporary local integration mode: peer services may call each other without JWTs.
# Set this to true after Identity/JWK and scoped service-token support are implemented.
SECURITY_ENABLED=false
OAUTH2_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# Keep stubs enabled until CIF is available. Set false to enable real Deposit upstream calls.
STUB_UPSTREAM_CLIENTS=true
CIF_URL=http://cif-service
PRODUCT_MASTER_URL=http://product-master-service
PRODUCT_MASTER_ACCESS_TOKEN=
UPSTREAM_CONNECT_TIMEOUT=2s
UPSTREAM_READ_TIMEOUT=5s

# Payments peer-service locations. Eureka service names are used by default.
DEPOSIT_BASE_URL=http://deposit-account-service
CREDIT_CARD_BASE_URL=http://credit-card-service
BILLING_BASE_URL=http://bill-generation-service
ACCOUNTING_BASE_URL=http://accounting-service
NOTIFICATION_BASE_URL=http://notification-service
