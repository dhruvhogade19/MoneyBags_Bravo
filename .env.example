# Copy this file to .env. All stateful Moneybags services then read the same Oracle connection.
# .env is ignored and must never be committed with real credentials.
MONEYBAGS_DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
MONEYBAGS_DB_USERNAME=moneybags
MONEYBAGS_DB_PASSWORD=change-me
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_ENABLED=true
OAUTH2_ISSUER_URI=http://localhost:8093
GATEWAY_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:8000
# Optional durable Identity signing-key location. The default is ${user.home}/.moneybags/identity-signing-key.json.
# MONEYBAGS_IDENTITY_JWK_PATH=C:/secure/path/identity-signing-key.json
# Optional when the BFF is not launched from ui-bff/: MONEYBAGS_UI_STATIC_LOCATION=C:/path/to/MoneyBag/moneybags-ui/web
SECURITY_ENABLED=true
M2M_CLIENT_SECRET=change-me
EOD_INITIAL_BUSINESS_DATE=2026-08-13
EOD_CURRENCY=INR
# Set true only after deploying a Statements service on STATEMENTS_URL.
EOD_STATEMENTS_ENABLED=false
